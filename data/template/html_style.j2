<html>
<head>
<style>
    body {
        font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
        margin: 0;
        padding: 0;
        /* 背景色由 Qt Dialog 自动提供，适配深色/浅色模式 */
    }
    
    /* === 顶部核心信息区域 - 大字号突出 === */
    .header {
        text-align: center;
        padding: 20px 15px;
        margin-bottom: 15px;
        border-bottom: 2px solid #ddd;
    }
    
    /* 日期 - 最大字号 */
    .date-big {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 8px;
    }
    
    /* 农历和星期 - 中等字号 */
    .lunar-date {
        font-size: 15px;
        margin-bottom: 15px;
    }
    
    /* 时间 - 超大字号 + 等宽字体 */
    .time-big {
        font-size: 48px;
        font-weight: bold;
        font-family: "Consolas", "Courier New", monospace;
        line-height: 1;
    }
    
    /* === 天气卡片 === */
    .weather-card {
        text-align: center;
        border-radius: 12px;
        padding: 15px;
        margin: 15px;
    }

    .weather-main {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .weather-detail {
        font-size: 13px;
        line-height: 1.8;
    }
    
    /* === 正文区域 === */
    .content {
        padding: 0 15px 15px;
    }
    
    /* 信息区块 */
    .section {
        margin-bottom: 12px;
        padding: 12px;
        border-left: 4px solid #ffb347;
        border-radius: 0 8px 8px 0;
    }
    
    .section-title {
        font-size: 15px;
        font-weight: bold;
        margin-bottom: 8px;
    }
    
    .section-content {
        font-size: 13px;
        line-height: 1.7;
    }
    
    .progress-text {
        font-weight: bold;
    }
    
    /* 每日一言 */
    .quote-box {
        border-radius: 8px;
        padding: 12px;
        margin-top: 8px;
    }

    .quote {
        font-style: italic;
        font-size: 14px;
        line-height: 1.6;
    }

    .quote-en {
        font-size: 12px;
        font-style: italic;
    }
    
    /* 底部 */
    .footer {
        text-align: center;
        font-size: 13px;
        padding: 10px;
        border-top: 1px solid #ddd;
    }
</style>
</head>
<body>
    <!-- 顶部核心信息 - 大字号突出 -->
    <div class="header">
        <div class="date-big">{{date}}</div>
        <div class="lunar-date">{{lunar_date}} · 星期{{weekday}} · 第{{week_num}}周 · 第{{day_num}}天</div>
        <div class="time-big">{{time}}</div>
    </div>
    
    <!-- 天气卡片 -->
    <div class="weather-card">
        <div class="weather-main">{{weather_emoji}} {{city_name}} · {{weather}}</div>
        <div class="weather-detail">
            🌡️ 温度 {{temperature}} · 体感{{feels_like}}<br>
            💧 湿度 {{humidity}} · 💨 {{wind_direction}} {{wind_speed}}<br>
            🌫️ AQI: {{air_quality}}
        </div>
    </div>
    
    <!-- 正文信息 -->
    <div class="content">
        <div class="section">
            <div class="section-title">⭐️ {{greeting}}</div>
            <div class="section-content">
                今天已开机 <b>{{startup_times}}</b> 次<br>
                节假日：{{holiday}} · 24 节气：{{solar_term}}
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">📊 年度进度</div>
            <div class="section-content">
                <span>今年已过 <span class="progress-text">{{year_progress}}</span></span>
                <span style="margin-left: 15px;">还剩 <span class="progress-text">{{year_remain}}</span></span>
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">📜 历史上的今天</div>
            <div class="section-content">
                <b>{{historical_date}}</b><br>
                {{historical_event}}
            </div>
        </div>
        
        <div class="section">
            <div class="section-title">💭 每日一言</div>
            <div class="quote-box">
                <div class="quote">{{every_day_words_zh}}</div>
                <div class="quote-en">{{every_day_words_en}}</div>
            </div>
        </div>
    </div>

    <!-- 底部 -->
    <div class="footer">
        <br>
        🌟 今天也要开心呀 🌟
    </div>
</body>
</html>
